# 복사해서 .env 로 쓰세요. .env 는 GitHub에 올라가지 않습니다(.gitignore).

# Supabase 대시보드 → Project Settings → API Keys / Data API 에서 복사
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Publishable key (sb_publishable_...) — 예전 프로젝트라면 legacy "anon" 키도 됩니다.
# secret / service_role 키는 RLS(사용자별 데이터 분리)를 우회하므로 절대 넣지 마세요.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

PORT=3000
# 내 컴퓨터는 127.0.0.1 (내 PC에서만 접속), Render 같은 배포 서버는 0.0.0.0
HOST=127.0.0.1
# 배포할 때는 production (로그인 쿠키를 https 에서만 보냄)
NODE_ENV=development
# 가입 확인 메일의 링크가 돌아올 주소 (배포 후에는 배포 주소)
APP_URL=http://localhost:3000
